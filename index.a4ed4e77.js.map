"use strict";
document.addEventListener("DOMContentLoaded", function() {
    var ths = document.querySelectorAll("thead th");
    var tbody = document.querySelector("tbody");
    ths.forEach(function(th, clickedIndex) {
        th.addEventListener("click", function() {
            var currentDirection = th.dataset.direction || "none";
            var nextDirection;
            if (currentDirection === "asc") nextDirection = "desc";
            else nextDirection = "asc"; // Default to asc if none or desc
            ths.forEach(function(header, index) {
                if (index === clickedIndex) {
                    header.dataset.direction = nextDirection;
                    // Оновлюємо візуальний стиль (приклад, можна адаптувати)
                    header.style.backgroundColor = "#d14534";
                    header.style.color = "white";
                    // Можна додати індикатори стрілок ▲ ▼
                    header.querySelectorAll(".sort-indicator").forEach(function(ind) {
                        return ind.remove();
                    }); // Видаляємо старі індикатори
                    var indicator = document.createElement("span");
                    indicator.classList.add("sort-indicator");
                    indicator.textContent = nextDirection === "asc" ? " \u25B2" : " \u25BC";
                    header.appendChild(indicator);
                } else {
                    delete header.dataset.direction;
                    // Скидаємо стиль для неактивних заголовків
                    header.style.backgroundColor = "";
                    header.style.color = "";
                    header.querySelectorAll(".sort-indicator").forEach(function(ind) {
                        return ind.remove();
                    });
                }
            });
            var columnIndex = clickedIndex;
            var rowsArray = Array.from(tbody.querySelectorAll("tr"));
            rowsArray.sort(function(rowA, rowB) {
                var cellA = rowA.children[columnIndex];
                var valueA = cellA.textContent.trim();
                var cellB = rowB.children[columnIndex];
                var valueB = cellB.textContent.trim();
                var compareResult;
                if (columnIndex === 0 || columnIndex === 1) compareResult = valueA.localeCompare(valueB);
                else {
                    var numA = parseFloat(valueA.replace(/[$,]/g, ""));
                    var numB = parseFloat(valueB.replace(/[$,]/g, ""));
                    if (isNaN(numA) && isNaN(numB)) compareResult = 0;
                    else if (isNaN(numA)) compareResult = 1; // Non-numbers go after numbers
                    else if (isNaN(numB)) compareResult = -1; // Numbers go before non-numbers
                    else compareResult = numA - numB;
                }
                // Якщо напрямок 'desc', інвертуємо результат порівняння
                return nextDirection === "desc" ? compareResult * -1 : compareResult;
            });
            tbody.innerHTML = "";
            rowsArray.forEach(function(row) {
                tbody.appendChild(row);
            });
        });
    });
});

